# ─── Tarea en Minutos — PRODUCCIÓN ────────────────────────────────────────
# Copia este archivo al servidor como /var/www/tareaenminutos/.env
# Luego:  chmod 600 /var/www/tareaenminutos/.env
#         chown www-data:www-data /var/www/tareaenminutos/.env
# ¡RELLENA TODOS LOS VALORES! Los de aquí son solo placeholders de ejemplo.

# ─── Seguridad ─────────────────────────────────────────────────────────────
# Genera una clave fuerte:  python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=REEMPLAZAR-POR-UNA-CLAVE-ALEATORIA-UNICA
DEBUG=False
# Tu dominio, separado por comas. NUNCA uses '*' en producción.
ALLOWED_HOSTS=tareaenminutos.com,www.tareaenminutos.com

# ─── SEO: Analytics y Search Console ───────────────────────────────────────
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
GOOGLE_SITE_VERIFICATION=

# ─── Site ───────────────────────────────────────────────────────────────────
# URL canónica pública (canonical/OG y emails). DEBE ser https en producción.
SITE_BASE_URL=https://tareaenminutos.com

# ─── Base de datos (PostgreSQL) ────────────────────────────────────────────
# Crea la BD y usuario en postgres primero:
#   sudo -u postgres createuser -P tem_user
#   sudo -u postgres createdb -O tem_user tem_db
DATABASE_URL=postgres://tem_user:TU_PASSWORD_DB@127.0.0.1:5432/tem_db

# ─── Channel layer (Redis) ──────────────────────────────────────────────────
# Redis debe estar corriendo (sudo apt install redis-server).
REDIS_URL=redis://127.0.0.1:6379/0

# ─── HTTPS / Seguridad (producción) ────────────────────────────────────────
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
# Orígenes de confianza para CSRF (nginx termina SSL)
CSRF_TRUSTED_ORIGINS=https://tareaenminutos.com,https://www.tareaenminutos.com

# ─── Email (SMTP) ──────────────────────────────────────────────────────────
# SIN EMAIL_HOST_USER no se envían los correos de notificación a tutores.
# Buzón del dominio en IONOS: servidor saliente smtp.ionos.com :587 TLS
# (cuenta española → smtp.ionos.es). Usuario = dirección completa + contraseña.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.ionos.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=soporte@tareaenminutos.com
EMAIL_HOST_PASSWORD=LA_CONTRASEÑA_DEL_CORREO
DEFAULT_FROM_EMAIL=soporte@tareaenminutos.com
